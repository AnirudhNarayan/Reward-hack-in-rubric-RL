# Copy to scripts/cluster.env (git-ignored) and fill from docs/cluster/<name>.raw.txt.
# Every SLURM script under scripts/slurm/opd/ sources this file; nothing cluster-specific is
# hard-coded in the scripts. Values below are PLACEHOLDERS, not confirmed UCF settings.

# ---- SLURM ----
export GPU_PARTITION=""            # e.g. the Newton GPU partition from `sinfo`
export CPU_PARTITION=""            # Stokes/Newton CPU partition for data prep + analysis
export ACCOUNT=""                  # -A value from `sacctmgr show assoc user=$USER` (empty = default)
export QOS=""                      # optional
export GPU_TYPE=""                 # optional GRES type, e.g. "h100" -> --gres=gpu:h100:N
export GPUS_PER_NODE=8             # GPUs per node on GPU_PARTITION
export CPUS_PER_GPU=8
export MEM_PER_NODE="0"            # "0" = all node memory (sbatch --mem=0)
export MAX_WALLTIME="72:00:00"     # partition MaxTime
export TRAIN_NODES=2               # RP-OPD 8B student + 70B teacher; see docs/CLUSTER.md sizing

# ---- software ----
export MODULES="cuda anaconda"     # space-separated `module load` list (confirm names with module avail)
export CONDA_ENV="rrh"

# ---- storage (scratch, never $HOME for checkpoints) ----
export SCRATCH_ROOT="/lustre/fs1/home/$(whoami)/rrh"       # CONFIRM
export DATA_DIR="$SCRATCH_ROOT/data"
export CKPT_ROOT="$SCRATCH_ROOT/checkpoints"
export HF_HOME="$SCRATCH_ROOT/hf_cache"
export RRH_CACHE="$SCRATCH_ROOT/cache/llm_cache.sqlite"   # judge response cache
export RESULTS_ROOT=""             # empty = <repo>/results

# ---- network ----
export COMPUTE_HAS_INTERNET=1      # 0 -> prepare_data must run where internet works; jobs go offline
