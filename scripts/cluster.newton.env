# UCF Newton settings, confirmed from `inspect_cluster.sh newton` on 2026-10-31 (docs/CLUSTER.md).
# Use: cp scripts/cluster.newton.env scripts/cluster.env
# Only the exact SCRATCH_ROOT directory is unconfirmed (marked CONFIRM).

# ---- SLURM ----
# highgpu = evc[101-104], 8x H100 SXM 80GB (GRES type nvidia_h100_80gb_hbm3), 128 CPUs, ~1 TB RAM,
# MaxTime UNLIMITED (DefaultTime 10 min, so every job must pass --time). Account `abedi` is in
# its AllowAccounts. All GPU jobs (training, 70B teacher/judges at TP=4) go here; the `normal`
# nodes have only 2x H100 PCIe each, too few for TP=4.
export GPU_PARTITION="highgpu"
export CPU_PARTITION="normal"      # no CPU-only partition on Newton; CPU jobs request no GPU
export ACCOUNT="abedi"             # sacctmgr: abedi (normal,ood,preemptable QOS, max 50 jobs)
export QOS=""                      # default QOS (normal), no MaxWall
export GPU_TYPE="nvidia_h100_80gb_hbm3"   # exact GRES type; "h100" would be rejected
export GPUS_PER_NODE=8
export CPUS_PER_GPU=16             # 128 CPUs / 8 GPUs
export MEM_PER_NODE="0"
export MAX_WALLTIME="48:00:00"     # segment length; partition has no limit, 48h keeps queue waits short
export TRAIN_NODES=2               # 16x H100 80GB = default sizing (docs/CLUSTER.md)

# ---- software ----
export MODULES="anaconda/anaconda-2024.10 cuda/cuda-12.6.0"
export CONDA_ENV="rrh"

# ---- storage (scratch, never $HOME for checkpoints) ----
export SCRATCH_ROOT="/lustre/fs1/home/$(whoami)/rrh"       # CONFIRM dir; quota 1 TB on /lustre/fs1
export DATA_DIR="$SCRATCH_ROOT/data"
export CKPT_ROOT="$SCRATCH_ROOT/checkpoints"
export HF_HOME="$SCRATCH_ROOT/hf_cache"
export RRH_CACHE="$SCRATCH_ROOT/cache/llm_cache.sqlite"   # judge response cache
export RESULTS_ROOT=""             # empty = <repo>/results

# ---- network ----
export COMPUTE_HAS_INTERNET=1      # confirmed: huggingface.co HTTP 200 from evc101
